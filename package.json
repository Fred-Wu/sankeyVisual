{
  "name": "powerbi-sankey-flow-visual",
  "description": "Sankey flow custom visual for Power BI.",
  "version": "1.0.0.0",
  "license": "MIT",
  "scripts": {
    "pbiviz": "pbiviz",
    "start": "pbiviz start",
    "package": "pbiviz package --certification-audit",
    "eslint": "npx eslint . --ext .js,.jsx,.ts,.tsx",
    "lint": "npm run eslint",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --audit-level=moderate",
    "check": "npm run lint && npm run typecheck && npm run audit && npm run package"
  },
  "dependencies": {
    "@types/d3": "7.4.3",
    "@types/d3-sankey": "^0.12.4",
    "d3": "7.9.0",
    "d3-sankey": "^0.12.3",
    "powerbi-visuals-api": "5.11.1",
    "powerbi-visuals-utils-formattingmodel": "7.1.0",
    "powerbi-visuals-utils-formattingutils": "6.1.2"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.57.1",
    "eslint": "9.39.4",
    "eslint-plugin-powerbi-visuals": "1.1.1",
    "powerbi-visuals-tools": "7.2.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "picomatch": "4.0.4",
    "js-yaml": "4.3.1",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@10.2.4": {
      "brace-expansion": "5.0.9"
    },
    "uuid": "11.1.1"
  }
}
